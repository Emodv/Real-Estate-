# =====================================================================
# TaxSale Copilot — Environment Variables
# =====================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# =====================================================================

# ---------------------------------------------------------------------
# App mode
# ---------------------------------------------------------------------
# "local"    -> No Supabase/auth required. Uses an in-memory/local data
#               store. Ideal for evaluating the underwriting engine and
#               UI without provisioning cloud infrastructure.
# "supabase" -> Full mode: Supabase Postgres + Supabase Auth (Google) + RLS.
NEXT_PUBLIC_APP_MODE=local

# ---------------------------------------------------------------------
# Supabase (only required when NEXT_PUBLIC_APP_MODE=supabase)
# ---------------------------------------------------------------------
# Public — safe for the browser. RLS protects the data even with the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SERVER-ONLY] NEVER expose to the client / never prefix with NEXT_PUBLIC.
# Not required by the app's runtime code (the app uses the user session). Only
# for privileged server tooling/migrations if you choose to use it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Access control — email allowlist (private tool, no public sign-up)
# ---------------------------------------------------------------------
# [SERVER-ONLY] Comma-separated list of authorized Google account emails.
# An authenticated email NOT in this list gets "Access Denied".
# Empty = deny everyone (fail closed). Designed to be replaced by a DB
# user_roles table later without changing call sites.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# ---------------------------------------------------------------------
# Google OAuth — CONFIGURED IN THE SUPABASE DASHBOARD, not read by this app
# ---------------------------------------------------------------------
# With Supabase Auth, the Google client ID/secret are entered in
#   Supabase -> Authentication -> Providers -> Google
# The app itself never reads these. They are listed here only so the full set
# of required configuration is documented in one place. Do NOT commit real
# values anywhere in this repo.
# GOOGLE_CLIENT_ID=            # set in Supabase dashboard
# GOOGLE_CLIENT_SECRET=        # [SERVER-ONLY] set in Supabase dashboard

# ---------------------------------------------------------------------
# Google Maps / Geocoding (server-only) — powers location intelligence
# ---------------------------------------------------------------------
# Used by src/lib/geo to geocode addresses and derive comparable distances.
# Server-only: never exposed to the browser. Optional — the app falls back to
# manual lat/lng entry when this is absent.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# AI providers (Phase 4+ — provider abstraction, server-only)
# ---------------------------------------------------------------------
# AI never performs financial math; it only supplies inputs/narrative that are
# validated by Zod. Keys are server-only and never sent to the client.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
