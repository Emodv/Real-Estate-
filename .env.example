# =====================================================================
# TaxSale Copilot — Environment Variables
# =====================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# =====================================================================

# ---------------------------------------------------------------------
# App mode
# ---------------------------------------------------------------------
# "local"    -> No Supabase/auth required. Uses an in-memory/local data
#               store. Ideal for evaluating the underwriting engine and
#               UI without provisioning cloud infrastructure.
# "supabase" -> Full mode: Supabase Postgres + Supabase Auth (Google).
NEXT_PUBLIC_APP_MODE=local

# ---------------------------------------------------------------------
# Supabase (only required when NEXT_PUBLIC_APP_MODE=supabase)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Used for privileged server
# operations / migrations tooling. Store only in server environment.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Google OAuth (configured inside the Supabase Auth dashboard, not here)
# ---------------------------------------------------------------------
# These are set in Supabase -> Authentication -> Providers -> Google.
# Documented in docs/SECURITY.md and docs/ENVIRONMENT.md.
# Do NOT place the Google client secret in this repository.

# ---------------------------------------------------------------------
# AI providers (Phase 4+ only — not used in Phase 1)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
